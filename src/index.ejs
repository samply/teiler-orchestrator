<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate, max-age=0">
  <meta http-equiv="Cache-Control" content="max-age=0, no-cache, no-store, must-revalidate">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title>Teiler</title>

  <!--
    Remove this if you only support browsers that support async/await.
    This is needed by babel to share largeish helper code for compiling async/await in older
    browsers. More information at https://github.com/single-spa/create-single-spa/issues/112
  -->
  <script src="<%= process.env.HTTP_RELATIVE_PATH || '' %>/libs/runtime.js"></script>

  <!--
    This CSP allows any SSL-enabled host and for arbitrary eval(), but you should limit these directives further to increase your app's security.
    Learn more about CSP policies at https://content-security-policy.com/#directive
  -->
  <meta http-equiv="Content-Security-Policy" content="default-src 'self' https: localhost:*; script-src 'unsafe-inline' 'unsafe-eval' https: localhost:* 127.0.0.1:*; connect-src https: localhost:* ws://localhost:*; style-src 'unsafe-inline' https:; object-src 'none';">
  <meta name="importmap-type" content="systemjs-importmap" />
  <!-- If you wish to turn off import-map-overrides for specific environments (prod), uncomment the line below -->
  <!-- More info at https://github.com/joeldenning/import-map-overrides/blob/master/docs/configuration.md#domain-list -->
  <!-- <meta name="import-map-overrides-domains" content="denylist:prod.example.com" /> -->

  <!-- Shared dependencies go into this import map. Your shared dependencies must be of one of the following formats:

    1. System.register (preferred when possible) - https://github.com/systemjs/systemjs/blob/master/docs/system-register.md
    2. UMD - https://github.com/umdjs/umd
    3. Global variable

    More information about shared dependencies can be found at https://single-spa.js.org/docs/recommended-setup#sharing-with-import-maps.
  -->
  <script type="systemjs-importmap">
    {
      "imports": {
        "single-spa": "<%= process.env.HTTP_RELATIVE_PATH || '' %>/libs/single-spa.min.js",
        "react": "<%= process.env.HTTP_RELATIVE_PATH || '' %>/libs/react.production.min.js",
        "react-dom": "<%= process.env.HTTP_RELATIVE_PATH || '' %>/libs/react-dom.production.min.js"
      }
    }
  </script>
  <link rel="preload" href="<%= process.env.HTTP_RELATIVE_PATH || '' %>/libs/single-spa.min.js" as="script" crossOrigin="anonymous" >

  <!-- Add your organization's prod import map URL to this script's src  -->
  <!-- <script type="systemjs-importmap" src="/importmap.json"></script> -->

  <script type="systemjs-importmap" src="<%= process.env.TEILER_BACKEND_URL + '/import-map' %>"></script>

  <!--
    If you need to support Angular applications, uncomment the script tag below to ensure only one instance of ZoneJS is loaded
    Learn more about why at https://single-spa.js.org/docs/ecosystem-angular/#zonejs
  -->
  <script src="<%= process.env.HTTP_RELATIVE_PATH || '' %>/libs/zone.js"></script>

  <script src="<%= process.env.HTTP_RELATIVE_PATH || '' %>/libs/import-map-overrides.js"></script>
  <% if (isLocal) { %>
  <script src="<%= process.env.HTTP_RELATIVE_PATH || '' %>/libs/system.js"></script>
  <script src="<%= process.env.HTTP_RELATIVE_PATH || '' %>/libs/amd.js"></script>
  <% } else { %>
  <script src="<%= process.env.HTTP_RELATIVE_PATH || '' %>/libs/system.min.js"></script>
  <script src="<%= process.env.HTTP_RELATIVE_PATH || '' %>/libs/amd.min.js"></script>
  <% } %>


  <script src="<%= process.env.TEILER_DASHBOARD_URL + '/' + process.env.DEFAULT_LANGUAGE + '/assets/env.js'%>"></script>


</head>
<body>
  <noscript>
    You need to enable JavaScript to run this app.
  </noscript>
  <script>
    System.import('@samply/root-config');
  </script>
  <import-map-overrides-full show-when-local-storage="devtools" dev-libs></import-map-overrides-full>
</body>
</html>
